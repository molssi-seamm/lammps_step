#!/usr/bin/env run_flowchart
format: MolSSI flowchart 3.0
metadata: {}
requires:
  crystal_builder_step: 2022.7.31
  forcefield_step: 2026.9.27
  lammps_step: 2026.10.1
  seamm: 2026.10.2
  supercell_step: 2025.6.25.1
digest:
  sha256: 315ad8ff6c9e00318ffac440c5b2f5b06c4cfc86f553d90b76f95daf9e03cfaf
  sha256_strict: fb25044fd9fbd8d76103c9a8426cbd654c69a4d914b7ea6cd9c5627a748198b9
steps:
- step: Forcefield
  parameters:
    task: setup forcefield
    forcefield_file: pcff2018.frc
    forcefield: default
    elements: []
    potentials: ''
- step: Crystal Builder
  parameters:
    prototype_group: common
    n_sites: any
    n_elements: any
    spacegroup: any
    pearson_symbol: any
    prototype: face-centered cubic (FCC)
    AFLOW prototype: A_cF4_225_a
    elements: [Ar]
    coordinates: []
    a: ['5.256', Å]
    b: ['10.0', Å]
    c: ['10.0', Å]
    alpha: ['90.0', degree]
    beta: ['90.0', degree]
    gamma: ['90.0', degree]
- step: Supercell
  parameters:
    na: '5'
    nb: '5'
    nc: '5'
- step: LAMMPS
  steps:
  - step: Initialization
    parameters:
      cutoff: ['10.0', Å]
      kspace_method: automatic
      kspace_accuracy: 1e-5
      kspace_smallq: 1e-5
      atomic charges: default for forcefield
      qeq convergence: 1.0e-06
      qeq iterations: 100
      charged_atom_fraction_cutoff: 0.1
      ewald_atom_cutoff: 1000
      msm_atom_cutoff: 5000
      tail_correction: 'yes'
      shift_nonbond: 'no'
      rigid_waters: 'yes'
      fix_XH_bond_lengths: none
  - step: Energy
    parameters:
      results: {}
      create tables: 'yes'
      structure handling: Overwrite the current configuration
      subsequent structure handling: Create a new system and configuration
      system name: keep current name
      configuration name: simulated with {model}
layout:
  '0': [150.0, 35.0]
  '1': [150.0, 105.0]
  '2': [150.0, 175.0]
  '3': [150.0, 245.0]
  '4': [150.0, 315.0]
  '4.0': [150.0, 35.0]
  '4.1': [150.0, 105.0]
  '4.2': [150.0, 175.0]
